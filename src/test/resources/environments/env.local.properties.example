# Wzorzec konfiguracji lokalnej.
# Skopiuj do env.local.properties (plik jest w .gitignore) i uruchom: mvn clean test -Denv=local
app.url=https://ing.pl
browser.headless=false
# Maksymalny czas oczekiwania na zapis cookie zgody i odstęp między kolejnymi odczytami (ms)
cookie.consent.timeout.ms=5000
cookie.consent.poll.interval.ms=100
# Nagrywanie Playwright trace; przy niepowodzeniu scenariusza trace trafia do target/traces i raportu Allure
trace.on.failure=true
# Domyślny limit czasu akcji Playwright (klik, wypełnienie, nawigacja) i asercji (tytuł, adres) w ms
timeout.action.ms=15000
timeout.assertion.ms=5000
